// Version resource: product name and file description are WizzairHelper (06 §4).
// The numbers come from project(VERSION) in CMakeLists.txt, the single source of the
// version (D-37): src/app/CMakeLists.txt generates wizz_version.h.
#include <winver.h>

#include "wizz_version.h"

// The application icon (D-51): icon/WizzairHelper.ico, made by tools/make_app_icon.py from
// the SVGs next to it. The exe's first icon group is the one Explorer, shortcuts, the
// taskbar and Apps & Features show, so this must stay the first (and only) one. IDI_ICON1
// is also the name Qt's Windows plugin loads as the default icon of its window class.
IDI_ICON1 ICON "icon/WizzairHelper.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WIZZ_VER_MAJOR, WIZZ_VER_MINOR, WIZZ_VER_PATCH, 0
 PRODUCTVERSION WIZZ_VER_MAJOR, WIZZ_VER_MINOR, WIZZ_VER_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WizzairHelper"
            VALUE "FileDescription",  "WizzairHelper"
            VALUE "FileVersion",      WIZZ_VER_FILE_STRING
            VALUE "InternalName",     "WizzairHelper"
            VALUE "OriginalFilename", "WizzairHelper.exe"
            VALUE "ProductName",      "WizzairHelper"
            VALUE "ProductVersion",   WIZZ_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
