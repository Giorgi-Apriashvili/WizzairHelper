// Version resource: product name and file description are WizzairHelper (06 §4).
#include <winver.h>

#define WIZZ_VER_MAJOR 1
#define WIZZ_VER_MINOR 0
#define WIZZ_VER_PATCH 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WIZZ_VER_MAJOR, WIZZ_VER_MINOR, WIZZ_VER_PATCH, 0
 PRODUCTVERSION WIZZ_VER_MAJOR, WIZZ_VER_MINOR, WIZZ_VER_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WizzairHelper"
            VALUE "FileDescription",  "WizzairHelper"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WizzairHelper"
            VALUE "OriginalFilename", "WizzairHelper.exe"
            VALUE "ProductName",      "WizzairHelper"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
