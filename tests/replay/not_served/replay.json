{
  "rules": [
    {
      "comment": "wizzair.com homepage advertising API 29.23.1 (05 §1.6 HOME_HTML)",
      "urlPrefix": "https://www.wizzair.com",
      "file": "home.html"
    },
    {
      "comment": "route map (copy of fixtures/map_subset.json, 11 airports)",
      "urlContains": "/asset/map",
      "file": "map_subset.json"
    },
    {
      "comment": "every other route: 400 InvalidMarket (not served)",
      "method": "POST",
      "urlContains": "/search/timetableV2",
      "status": 400,
      "file": "error_invalid_market.json",
      "delayMs": 500
    },
    {
      "comment": "exchange rates (copy of fixtures/fx_frankfurter_v2.json)",
      "urlContains": "frankfurter",
      "file": "fx_frankfurter_v2.json"
    }
  ]
}
